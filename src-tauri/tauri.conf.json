{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leverframe",
  "version": "0.5.0",
  "identifier": "io.github.tarze07.leverframe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Leverframe",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "tarze07",
    "homepage": "https://github.com/tarze07/Leverframe",
    "category": "DeveloperTool",
    "shortDescription": "Terminal z edytorem dla agentów CLI",
    "longDescription": "Leverframe to lekki terminal z edytorem w stylu VS Code / Zed: terminale lokalne, WSL, SSH i PowerShell w zakładkach i podziałach, z myślą o pracy z agentami CLI.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Polish",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "upgradeCode": "e286adf0-9302-5abd-ba64-a9c4bdf9f289"
      }
    }
  }
}
